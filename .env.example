# Copy to .env and fill in the values. Never commit .env.

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
# GPT-6 Luna code generation may need a larger completion budget.
OPENAI_MAX_COMPLETION_TOKENS=65536

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_MODEL=deepseek.v3.2
AWS_BEDROCK_REGION=us-east-1
MONGODB_URL=mongodb://localhost:27017/multiagent
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

MAX_AGENT_RETRIES=3
MAX_ARCHITECTURE_ITERATIONS=3
MAX_DEBUG_ITERATIONS=5
SANDBOX_TIMEOUT=300000
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
